# LLM API Keys
# Google Gemini API Key (Required - Gemini Pro Plan / Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider: 'gemini' (default)
LLM_PROVIDER=gemini

# Gemini Model: gemini-3.1-flash-lite (fastest, recommended), gemini-3.6-flash, gemini-2.5-flash
GEMINI_MODEL=gemini-3.1-flash-lite

# Server settings
PORT=8000
HOST=127.0.0.1

# Optional custom workspace folder (defaults to ./mcp-workspace if commented out)
# For Windows Desktop access (Option A):
# WORKSPACE_DIR=C:/Users/YourUsername/OneDrive/Desktop
# or for standard local folder:
# WORKSPACE_DIR=f:/Projects/mcp-filesystem/mcp-workspace
