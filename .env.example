# LLM API Keys
# Google Gemini API Key (Required - Gemini Pro Plan / Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider: 'gemini' (default)
LLM_PROVIDER=gemini

# Gemini Model: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# Server settings
PORT=8000
HOST=127.0.0.1

# Optional custom workspace folder (defaults to ./mcp-workspace)
# WORKSPACE_DIR=f:/Projects/mcp-filesystem/mcp-workspace
